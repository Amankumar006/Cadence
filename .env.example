# Cadence environment configuration.
#
# Copy to .env and fill in. `neon env pull` writes DATABASE_URL and
# DATABASE_URL_UNPOOLED for you -- do not hand-edit those two.
#
#   cp .env.example .env
#   neon env pull
#
# .env is gitignored. This file is not: keep it free of real values.

# ── Postgres (Neon) ─────────────────────────────────────────────────────────
#
# Two DSNs for the same database, and they are NOT interchangeable.
#
#   DATABASE_URL          POOLED. Hostname carries a `-pooler` suffix and routes
#                         through PgBouncer in transaction mode. Use for the
#                         application's normal query traffic.
#
#   DATABASE_URL_UNPOOLED DIRECT. No `-pooler` suffix. Use for schema
#                         migrations, `setup()` DDL, pg_dump, logical
#                         replication, LISTEN/NOTIFY, and anything relying on
#                         SET or other session state.
#
# Running DDL over the pooled endpoint fails on Neon in ways that never name
# pooling: `prepared statement "s0" already exists`, a `SET search_path` that
# does not survive its own transaction, or a write landing in a read-only
# transaction the pooler inherited from an earlier client.
#
# If DATABASE_URL_UNPOOLED is unset, app/db.py falls back to the pooled DSN and
# logs a warning. That is correct for a local Postgres and merely degraded (not
# broken) on Neon -- but set it.
#
# A local Postgres needs only one value:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent_planner

DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Pool sizing for the LangGraph store. The checkpointer gets its own smaller
# pool. Raise only if you see pool timeouts under load.
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# ── LLM providers ───────────────────────────────────────────────────────────
# At least one is required. Without any, the app boots and every LLM call
# degrades to the deterministic fallback.

GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Model ids per tier. Gemini 3.8 Flash is the workhorse (schedule building,
# parsing, summaries); 3.5 Flash-Lite does routing and is ~2.5x cheaper.
PRIMARY_MODEL=gemini-3.8-flash
ROUTING_MODEL=gemini-3.5-flash-lite
SECONDARY_MODEL=llama-3.3-70b-versatile
LLM_MAX_ATTEMPTS=2
# When true, every LLM call is skipped and deterministic paths are used.
DEMO_MODE=false

# ── Observability ───────────────────────────────────────────────────────────
# LangSmith tracing turns on automatically when a key is present.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=personal-ai-agent

# ── TMDB (movie recommendations) ────────────────────────────────────────────
TMDB_API_KEY=

# ── Firebase ────────────────────────────────────────────────────────────────
# Auth + FCM stay on Firebase even with data in Postgres. Without credentials
# the app runs in local-dev auth fallback, where the request body supplies
# user_id and tokens are NOT verified -- never deploy that way.
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
DEV_FALLBACK_USER_ID=mock_user_123

# ── Server ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
