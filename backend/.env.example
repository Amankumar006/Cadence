# Cadence backend configuration.
#
# Copy to .env and fill in. The app IMPORTS without any of these set (missing
# keys just disable the relevant integration), but it will not be able to call
# an LLM or talk to Firebase until GEMINI_API_KEY / Firebase credentials exist.
#
#   cp backend/.env.example backend/.env

# ── Server ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── LLM ─────────────────────────────────────────────────────────────────────
# Google AI Studio key (required for schedule building, note summaries,
# intent classification, syllabus/calendar extraction).
GEMINI_API_KEY=
# Groq key for the secondary model (optional — if unset, the chain has no
# fallback and every call degrades to its deterministic fallback instead).
GROQ_API_KEY=
# OpenRouter key is read by config but no longer used as an LLM fallback.
OPENROUTER_API_KEY=

# Model ids. Gemini 2.5 is only served to accounts that already used it, so
# the default is the current GA workhorse. Override per environment.
PRIMARY_MODEL=gemini-3.8-flash
SECONDARY_MODEL=llama-3.3-70b-versatile
# Bound on LLM attempts before the deterministic fallback is used.
LLM_MAX_ATTEMPTS=2
LLM_MAX_RETRIES=1
# When true, every LLM call is skipped and deterministic paths are used
# (handy for demos and CI). Equivalent to the test_* user-id bypass.
DEMO_MODE=false

# ── LangSmith (optional tracing) ────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=personal-ai-agent

# ── Storage ─────────────────────────────────────────────────────────────────
# LangGraph checkpoint / store connection string.
DB_URI=postgresql://postgres:postgres@localhost:5432/agent_planner

# ── Firebase ────────────────────────────────────────────────────────────────
# Path to the service-account JSON (relative to backend/). Never commit it.
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
# Alternative to the file: raw values from the same service account.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key with literal \n escapes.
FIREBASE_PRIVATE_KEY=
# Uid used by the auth dependency when Firebase is NOT configured
# (local development only). In production the token uid always wins.
DEV_FALLBACK_USER_ID=mock_user_123

# ── Integrations ────────────────────────────────────────────────────────────
TMDB_API_KEY=
EXPO_ACCESS_TOKEN=
